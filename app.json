{
  "expo": {
    "name": "music-social",
    "slug": "music-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "musicsocial",
      "ovrlee-spotify"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "deploymentTarget": "17.0",
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.brewskiii.musicsocial",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppleMusicUsageDescription": "NOW uses your Apple Music activity and library to help you discover people who listen like you.",
        "NSMicrophoneUsageDescription": "NOW uses the microphone only when you start a Shazam Lab recognition test to identify nearby music.",
        "LSApplicationQueriesSchemes": [
          "spotify"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/with-ios-17",
      "@wwdrew/expo-apple-music",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#39E75F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec97215f-fbf5-47ed-a26d-5626c7dde9c5"
      }
    }
  }
}
