{
  "expo": {
    "name": "OVRLEE",
    "slug": "music-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": [
      "musicsocial",
      "ovrlee-spotify",
      "ovrlee"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "deploymentTarget": "17.0",
      "bundleIdentifier": "com.brewskiii.musicsocial",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppleMusicUsageDescription": "OVRLEE uses your Apple Music library and listening to build your music identity, find people who listen like you, and play listening parties in sync.",
        "NSMicrophoneUsageDescription": "OVRLEE uses the microphone only when you tap Recognize Music to identify a song playing near you.",
        "LSApplicationQueriesSchemes": [
          "spotify"
        ],
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#3B2218"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3B2218",
          "imageWidth": 200
        }
      ],
      "./plugins/with-ios-17",
      "@wwdrew/expo-apple-music",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3B2218"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Post to OVRLEE",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "disableAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec97215f-fbf5-47ed-a26d-5626c7dde9c5"
      }
    }
  }
}
