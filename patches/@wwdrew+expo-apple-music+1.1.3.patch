+// SystemPlaybackReader.swift
+// Read-only system playback reader for NOW.
+//
+// SystemMusicPlayer is the source of truth for whether
+// Apple Music is actually playing and which song is
+// currently playing.
+//
+// Some SystemMusicPlayer queue entries contain title,
+// artist, and ID but omit artwork. When that happens,
+// NOW attempts to enrich the exact song from Apple's
+// music catalog so the live presence card can still
+// display album artwork.
+
+import Foundation
+import MusicKit
+
+@available(iOS 16.0, *)
+final class SystemPlaybackReader {
+
+  // MARK: - Shared Instance
+
+  static let shared = SystemPlaybackReader()
+
+  // MARK: - Player
+
+  private var player: SystemMusicPlayer {
+    SystemMusicPlayer.shared
+  }
+
+  private init() {}
+
+  // MARK: - Current Playback
+
+  func getCurrentPlayback() async -> [String: Any] {
+    let state = player.state
+
+    var result: [String: Any] = [
+      "playbackStatus": describePlaybackStatus(
+        state.playbackStatus
+      ),
+      "playbackRate": state.playbackRate,
+      "hasCurrentEntry": false
+    ]
+
+    guard let entry = player.queue.currentEntry else {
+      return result
+    }
+
+    result["hasCurrentEntry"] = true
+
+    switch entry.item {
+
+    case .song(let song):
+      result["itemType"] = "song"
+
+      let mappedSong =
+        await mapSongWithArtworkFallback(song)
+
+      result["currentSong"] = mappedSong
+
+    case .musicVideo(let musicVideo):
+      result["itemType"] = "musicVideo"
+      result["currentSong"] =
+        MusicItemMapper.map(musicVideo)
+
+    default:
+      result["itemType"] = "other"
+    }
+
+    return result
+  }
+
+  // MARK: - Song Artwork Enrichment
+
+  private func mapSongWithArtworkFallback(
+    _ song: Song
+  ) async -> [String: Any] {
+
+    /*
+     * First map the exact Song object supplied by
+     * SystemMusicPlayer.
+     *
+     * If SystemMusicPlayer included artwork, nothing
+     * else needs to happen.
+     */
+    let systemMappedSong =
+      MusicItemMapper.map(song)
+
+    if let artworkUrl =
+      systemMappedSong["artworkUrl"] as? String,
+       !artworkUrl.isEmpty {
+
+      return systemMappedSong
+    }
+
+    /*
+     * SystemMusicPlayer occasionally provides a partial
+     * Song object. It still identifies the exact song,
+     * but artwork may not be hydrated.
+     *
+     * Use that exact MusicItemID to request the complete
+     * catalog Song.
+     */
+    do {
+      var request =
+        MusicCatalogResourceRequest<Song>(
+          matching: \.id,
+          equalTo: song.id
+        )
+
+      request.limit = 1
+
+      let response =
+        try await request.response()
+
+      guard let catalogSong =
+        response.items.first else {
+
+        return systemMappedSong
+      }
+
+      let catalogMappedSong =
+        MusicItemMapper.map(catalogSong)
+
+      /*
+       * Keep SystemMusicPlayer's metadata as our
+       * playback truth and only fill the missing
+       * artwork from the catalog response.
+       */
+      guard let catalogArtworkUrl =
+        catalogMappedSong["artworkUrl"] as? String,
+        !catalogArtworkUrl.isEmpty else {
+
+        return systemMappedSong
+      }
+
+      var enrichedSong =
+        systemMappedSong
+
+      enrichedSong["artworkUrl"] =
+        catalogArtworkUrl
+
+      return enrichedSong
+
+    } catch {
+      /*
+       * Artwork enrichment is optional.
+       *
+       * A catalog/network failure must NEVER cause NOW
+       * to lose a valid live playback result.
+       */
+      print(
+        "NOW artwork enrichment error:",
+        error.localizedDescription
+      )
+
+      return systemMappedSong
+    }
+  }
+
+  // MARK: - Playback Status
+
+  private func describePlaybackStatus(
+    _ status: MusicPlayer.PlaybackStatus
+  ) -> String {
+
+    switch status {
+
+    case .playing:
+      return "playing"
+
+    case .paused:
+      return "paused"
+
+    case .stopped:
+      return "stopped"
+
+    case .interrupted:
+      return "interrupted"
+
+    case .seekingForward:
+      return "seekingForward"
+
+    case .seekingBackward:
+      return "seekingBackward"
+
+    @unknown default:
+      return "unknown"
+    }
+  }
+}
